# ============================================================
# Production deployment (Oracle + Coolify): set ALL of these in
# Coolify's environment store. NEVER commit real values.
# MEDUSA_BACKEND_URL must also be marked as a BUILD variable in
# Coolify (the admin SPA bakes it in at build time).
# ============================================================

NODE_ENV=production

# --- Database (postgres service in docker-compose) ---
# Compose assembles DATABASE_URL from these three:
POSTGRES_USER=medusa
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=medusa
# For local dev outside compose, set it directly:
DATABASE_URL=postgres://localhost/medusa_aza

# --- Redis (redis service in docker-compose) ---
# Enables redis cache, event bus, and workflow engine modules.
# Leave UNSET in local dev to fall back to in-memory equivalents.
REDIS_URL=redis://redis:6379

# --- Worker split ---
# "server" = HTTP + admin | "worker" = jobs/subscribers/cron | "shared" = both (dev)
# Set per-service in docker-compose; not needed in Coolify's global env.
MEDUSA_WORKER_MODE=shared

# --- Auth secrets (generate: openssl rand -base64 48) ---
JWT_SECRET=your-jwt-secret-change-in-production
COOKIE_SECRET=your-cookie-secret-change-in-production

# --- CORS (production values shown; comma-separated lists allowed) ---
STORE_CORS=https://alizaenalabidin.com,https://www.alizaenalabidin.com
ADMIN_CORS=https://api.alizaenalabidin.com
AUTH_CORS=https://api.alizaenalabidin.com,https://alizaenalabidin.com,https://www.alizaenalabidin.com

# --- Backend URL (public URL of this backend; also a Coolify BUILD var) ---
MEDUSA_BACKEND_URL=https://api.alizaenalabidin.com

# --- Midtrans payment provider ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Admin ---
# Worker mode disables the admin automatically; this is an extra manual switch.
DISABLE_MEDUSA_ADMIN=false
